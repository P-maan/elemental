<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key>                 <string>Elemental</string>
  <key>CFBundleDisplayName</key>          <string>Elemental</string>
  <key>CFBundleExecutable</key>           <string>Elemental</string>
  <key>CFBundleIdentifier</key>           <string>com.prakritmaan.elemental</string>
  <key>CFBundlePackageType</key>          <string>APPL</string>
  <!-- Icons/Elemental002.icns, copied in by build.sh. The user can pick a
       different design in Settings; that is applied as a custom Finder icon
       at runtime, which does not touch anything under Contents. -->
  <key>CFBundleIconFile</key>             <string>AppIcon</string>
  <key>CFBundleShortVersionString</key>   <string>0.2</string>
  <key>CFBundleVersion</key>              <string>2</string>
  <key>LSMinimumSystemVersion</key>       <string>14.0</string>

  <!-- Background agent: no Dock icon, no app switcher entry. Settings is
       reached from the menu-bar item, or by launching the app again. -->
  <key>LSUIElement</key>                  <true/>

  <key>NSHighResolutionCapable</key>      <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key> <true/>

  <key>NSLocationWhenInUseUsageDescription</key>
  <string>Elemental uses your location to place the sun, moon and stars correctly in the wallpaper. It is read once and stored only on this Mac.</string>
  <key>NSLocationUsageDescription</key>
  <string>Elemental uses your location to place the sun, moon and stars correctly in the wallpaper. It is read once and stored only on this Mac.</string>
</dict>
</plist>
